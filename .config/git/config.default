[advice]
    skippedCherryPicks = false

[branch]
    sort = -committerdate

[color]
    grep = always

[commit]
    gpgsign = true

[core]
    autocrlf = input
    commentChar = ";"
    pager = delta

[delta]
    side-by-side = true

[diff]
    algorithm = histogram
    colorMoved = zebra
    tool = nvimdiff

[difftool]
    prompt = false

[gpg]
    format = ssh

[grep]
    column = true
    lineNumber = true

[init]
    defaultBranch = main

[rerere]
    enabled = true

[tag]
    gpgsign = true

[user]
    email = meanderingprogrammer@gmail.com
    name = MeanderingProgrammer
    signingkey = ~/.ssh/id_ed25519.pub
